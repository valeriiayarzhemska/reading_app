# Copy to .env. EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
# iOS Simulator: localhost works. Android emulator: http://10.0.2.2:3001.
# Real phone: your Mac's Wi-Fi IP, e.g. http://192.168.1.23:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Google Sign-In (client IDs are public, not secrets)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
