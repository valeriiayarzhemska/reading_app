generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Keep in sync with packages/shared/src/enums.ts
enum ShelfStatus {
  WANT_TO_READ
  READING
  READ
  ABANDONED
}

enum BookFormat {
  PAPER
  EBOOK
  AUDIO
}

enum ProgressUnit {
  PAGES
  PERCENT
  MINUTES
}

// How exactly a date is known: a book read years ago may only have a year
// Keep in sync with packages/shared/src/notifications.ts
enum NotificationType {
  FOLLOW
  POST_LIKE
  POST_COMMENT
  COMMENT_LIKE
}

enum DatePrecision {
  DAY
  MONTH
  YEAR
}

model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  nickname    String    @unique
  displayName String
  avatarUrl   String?
  bio         String?
  links       String[]  @default([])
  timezone    String    @default("Europe/Kyiv")
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts        AuthAccount[]
  authSessions    AuthSession[]
  userBooks       UserBook[]
  readingSessions ReadingSession[]
  createdBooks    Book[]
  readingGoals    ReadingGoal[]
  favoriteBooks   FavoriteBook[]
  // Two relations to Follow: the names pair each list with its foreign key
  following       Follow[]          @relation("following")
  followers       Follow[]          @relation("followers")
  collections     Collection[]
  collectionLikes CollectionLike[]
  hostedClubs     Club[]
  clubMemberships ClubMember[]
  messages        Message[]
  reactions       MessageReaction[]
  posts           Post[]
  postLikes       PostLike[]
  comments        Comment[]
  commentLikes    CommentLike[]
  // Two relations to Notification: what I receive, and what I caused
  notifications   Notification[]    @relation("recipient")
  sentNotices     Notification[]    @relation("actor")
  achievements    UserAchievement[]
}

// One row per signed-in device. Only the refresh token's hash is stored.
model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id             String @id @default(uuid())
  provider       String // "apple" | "google"
  providerUserId String
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Book {
  id               String   @id @default(uuid())
  googleBooksId    String?  @unique
  openLibraryId    String?  @unique
  title            String
  authors          String[]
  coverUrl         String?
  pageCount        Int?
  audioDurationMin Int?
  language         String?
  // Who typed the book in by hand. Such books are public like imported ones;
  // what marks them as manual is having neither external ID. SetNull: when
  // the creator deletes their account, the book stays on others' shelves.
  createdById      String?
  // Stored, not computed on every read: recalculated whenever a rating
  // changes or a shelf entry goes (see src/books/book-rating.ts)
  ratingAvg        Float?
  ratingCount      Int      @default(0)
  createdAt        DateTime @default(now())

  createdBy     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  userBooks     UserBook[]
  inCollections CollectionBook[]
  readInClubs   Club[]
  inPosts       Post[]

  @@index([createdById])
}

model UserBook {
  id                String        @id @default(uuid())
  userId            String
  bookId            String
  status            ShelfStatus
  format            BookFormat
  progressUnit      ProgressUnit
  currentProgress   Int           @default(0)
  rating            Int? // 1–10
  startedAt         DateTime?
  finishedAt        DateTime?
  // MONTH: finishedAt is the 15th; YEAR: 1 July. The app shows "≈ 2021".
  finishedPrecision DatePrecision @default(DAY)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sessions ReadingSession[]
  favorite FavoriteBook?
  review   Review?
  quotes   Quote[]
  notes    Note[]

  @@unique([userId, bookId, format])
  @@index([userId, status])
  // A book's ratings and reviews: all entries of one book
  @@index([bookId])
}

// One per shelf entry. The rating stays on UserBook: you can rate without
// writing anything.
model Review {
  id          String   @id @default(uuid())
  userBookId  String   @unique
  text        String
  hasSpoilers Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  // Newest first on the book page
  @@index([createdAt])
}

model ReadingSession {
  id           String       @id @default(uuid())
  clientId     String       @unique // idempotency key for offline sync
  userId       String
  userBookId   String
  startedAt    DateTime // UTC
  endedAt      DateTime // UTC
  durationSec  Int
  unit         ProgressUnit
  progressFrom Int
  progressTo   Int
  createdAt    DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt]) // calendar queries
  @@index([userBookId])
}

// "Read 25 books in 2026". One per user per year: saving again updates it.
model ReadingGoal {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  // Number of books to finish that year
  target    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

// "Four favorites" on the profile. Rows have no built-in order, so the order
// is data: position 1–4. The whole list is replaced on every save.
model FavoriteBook {
  id         String @id @default(uuid())
  userId     String
  userBookId String @unique
  position   Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Removing the book from the shelf removes it from the favorites too
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  // No two books in one slot
  @@unique([userId, position])
}

// "follower follows following". Public: no requests to approve.
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  // The pair is the key: following someone twice is impossible
  @@id([followerId, followingId])
  // The key's index starts with followerId; "who follows X" needs this one
  @@index([followingId, createdAt])
}

// "Best fantasy of 2026": an ordered list of books, public on the profile
model Collection {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  books CollectionBook[]
  likes CollectionLike[]

  // A profile's collections, newest first
  @@index([userId, createdAt])
}

// Books, not shelf entries: removing a book from the shelf keeps it here,
// and anyone can open it. The order is data, as with favorites.
model CollectionBook {
  collectionId String
  bookId       String
  position     Int

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  book       Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // A book appears once per collection
  @@id([collectionId, bookId])
  @@unique([collectionId, position])
  @@index([bookId])
}

model CollectionLike {
  userId       String
  collectionId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // One like per reader; the key's index starts with userId, counting a
  // collection's likes needs its own
  @@id([userId, collectionId])
  @@index([collectionId])
}

// A reading club ("room"): open to everyone, one host
model Club {
  id          String   @id @default(uuid())
  name        String
  description String?
  // One of CLUB_COLORS: the avatar circle
  color       String
  hostId      String
  // "Reading together": the book the club reads now, chosen by the host
  bookId      String?
  createdAt   DateTime @default(now())

  // Cascade: a club without its host goes too
  host     User         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  book     Book?        @relation(fields: [bookId], references: [id], onDelete: SetNull)
  members  ClubMember[]
  messages Message[]

  @@index([hostId])
  @@index([createdAt])
}

model ClubMember {
  clubId     String
  userId     String
  joinedAt   DateTime @default(now())
  // Messages after this are unread (the dots and counts, CLB-2)
  lastReadAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "My clubs" searches by userId: the key starts with clubId, so it needs
  // its own index
  @@id([clubId, userId])
  @@index([userId])
}

// A chat message in a club
model Message {
  id        String   @id @default(uuid())
  // Made by the app before sending: a retried send is recognised, not
  // stored twice (as with reading sessions)
  clientId  String   @unique
  clubId    String
  authorId  String
  // May be "" when the message is a photo
  text      String
  photoUrl  String?
  // The message this one answers (quoted above it)
  replyToId String?
  createdAt DateTime @default(now())

  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // A self-relation: a message points at another message. SetNull: if the
  // original goes, the reply stays as a normal message.
  replyTo   Message?          @relation("replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("replies")
  reactions MessageReaction[]

  // History pages and unread counts: one club's messages by time
  @@index([clubId, createdAt])
}

// One emoji from one reader on one message
model MessageReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The same emoji twice from one reader is impossible; different emojis are fine
  @@id([messageId, userId, emoji])
}

// A post on Shelves: text, optionally a book card and one photo, or a
// shared quote
model Post {
  id        String   @id @default(uuid())
  authorId  String
  // May be "" when there is a photo or a quote
  text      String
  bookId    String?
  photoUrl  String?
  // A copy, not a link: editing or deleting the private quote later
  // doesn't change a post others have already liked and commented on
  quoteText String?
  quotePage Int?
  createdAt DateTime @default(now())

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // SetNull: deleting the book keeps the post, without its card
  book          Book?          @relation(fields: [bookId], references: [id], onDelete: SetNull)
  likes         PostLike[]
  comments      Comment[]
  notifications Notification[]

  // "All": everyone's posts by time; "Following": by author, then time
  @@index([createdAt])
  @@index([authorId, createdAt])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes         CommentLike[]
  notifications Notification[]

  // A post's comments in order
  @@index([postId, createdAt])
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

// "bob liked your post": one row per event, for the list and the 🔔 badge
model Notification {
  id        String           @id @default(uuid())
  // Who receives it
  userId    String
  // Who caused it
  actorId   String
  type      NotificationType
  // What it's about (FOLLOW has neither)
  postId    String?
  commentId String?
  // null: unread
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  // Cascade: a deleted post takes its notifications along
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // My notifications, newest first
  @@index([userId, createdAt])
}

// A line worth keeping, saved on your shelf entry. Private until shared.
model Quote {
  id         String   @id @default(uuid())
  userBookId String
  text       String
  // Unknown for e-books and audiobooks
  page       Int?
  createdAt  DateTime @default(now())

  // Removing the book from the shelf removes its quotes
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  @@index([userBookId, createdAt])
}

// A private thought about a book: on the book screen, or a "quick thought"
// during a timer session. Unlike a quote, it can be edited.
model Note {
  id         String   @id @default(uuid())
  userBookId String
  text       String
  page       Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  @@index([userBookId, createdAt])
}

// A badge a reader has earned. The rules live in code (achievements.rules.ts),
// so `code` is a plain string: a new badge needs no migration. Once earned,
// it stays.
model UserAchievement {
  userId   String
  code     String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
  // "How many readers have this badge": counted by code
  @@index([code])
}

// Written by the nightly job: how many readers hold each badge. Reading a
// stored number beats counting on every request.
model AchievementStat {
  code      String   @id
  holders   Int
  // Readers counted (with at least one book on their shelf)
  readers   Int
  updatedAt DateTime @updatedAt
}
