generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Keep in sync with packages/shared/src/enums.ts
enum ShelfStatus {
  WANT_TO_READ
  READING
  READ
  ABANDONED
}

enum BookFormat {
  PAPER
  EBOOK
  AUDIO
}

enum ProgressUnit {
  PAGES
  PERCENT
  MINUTES
}

model User {
  id          String   @id @default(uuid())
  email       String?  @unique
  nickname    String   @unique
  displayName String
  avatarUrl   String?
  bio         String?
  links       String[]  @default([])
  timezone    String    @default("Europe/Kyiv")
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts        AuthAccount[]
  authSessions    AuthSession[]
  userBooks       UserBook[]
  readingSessions ReadingSession[]
  createdBooks    Book[]
}

// One row per signed-in device. Only the refresh token's hash is stored.
model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id             String @id @default(uuid())
  provider       String // "apple" | "google"
  providerUserId String
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Book {
  id               String   @id @default(uuid())
  googleBooksId    String?  @unique
  openLibraryId    String?  @unique
  title            String
  authors          String[]
  coverUrl         String?
  pageCount        Int?
  audioDurationMin Int?
  language         String?
  // Who typed the book in by hand. Such books are public like imported ones;
  // what marks them as manual is having neither external ID. SetNull: when
  // the creator deletes their account, the book stays on others' shelves.
  createdById      String?
  createdAt        DateTime @default(now())

  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  userBooks UserBook[]

  @@index([createdById])
}

model UserBook {
  id              String       @id @default(uuid())
  userId          String
  bookId          String
  status          ShelfStatus
  format          BookFormat
  progressUnit    ProgressUnit
  currentProgress Int          @default(0)
  rating          Int? // 1–10
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sessions ReadingSession[]

  @@unique([userId, bookId, format])
  @@index([userId, status])
}

model ReadingSession {
  id           String       @id @default(uuid())
  clientId     String       @unique // idempotency key for offline sync
  userId       String
  userBookId   String
  startedAt    DateTime // UTC
  endedAt      DateTime // UTC
  durationSec  Int
  unit         ProgressUnit
  progressFrom Int
  progressTo   Int
  createdAt    DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt]) // calendar queries
  @@index([userBookId])
}
