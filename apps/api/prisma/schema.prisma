generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Keep in sync with packages/shared/src/enums.ts
enum ShelfStatus {
  WANT_TO_READ
  READING
  READ
  ABANDONED
}

enum BookFormat {
  PAPER
  EBOOK
  AUDIO
}

enum ProgressUnit {
  PAGES
  PERCENT
  MINUTES
}

// How exactly a date is known: a book read years ago may only have a year
enum DatePrecision {
  DAY
  MONTH
  YEAR
}

model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  nickname    String    @unique
  displayName String
  avatarUrl   String?
  bio         String?
  links       String[]  @default([])
  timezone    String    @default("Europe/Kyiv")
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts        AuthAccount[]
  authSessions    AuthSession[]
  userBooks       UserBook[]
  readingSessions ReadingSession[]
  createdBooks    Book[]
  readingGoals    ReadingGoal[]
  favoriteBooks   FavoriteBook[]
  // Two relations to Follow: the names pair each list with its foreign key
  following       Follow[]         @relation("following")
  followers       Follow[]         @relation("followers")
}

// One row per signed-in device. Only the refresh token's hash is stored.
model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id             String @id @default(uuid())
  provider       String // "apple" | "google"
  providerUserId String
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Book {
  id               String   @id @default(uuid())
  googleBooksId    String?  @unique
  openLibraryId    String?  @unique
  title            String
  authors          String[]
  coverUrl         String?
  pageCount        Int?
  audioDurationMin Int?
  language         String?
  // Who typed the book in by hand. Such books are public like imported ones;
  // what marks them as manual is having neither external ID. SetNull: when
  // the creator deletes their account, the book stays on others' shelves.
  createdById      String?
  createdAt        DateTime @default(now())

  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  userBooks UserBook[]

  @@index([createdById])
}

model UserBook {
  id                String        @id @default(uuid())
  userId            String
  bookId            String
  status            ShelfStatus
  format            BookFormat
  progressUnit      ProgressUnit
  currentProgress   Int           @default(0)
  rating            Int? // 1–10
  startedAt         DateTime?
  finishedAt        DateTime?
  // MONTH: finishedAt is the 15th; YEAR: 1 July. The app shows "≈ 2021".
  finishedPrecision DatePrecision @default(DAY)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sessions ReadingSession[]
  favorite FavoriteBook?

  @@unique([userId, bookId, format])
  @@index([userId, status])
}

model ReadingSession {
  id           String       @id @default(uuid())
  clientId     String       @unique // idempotency key for offline sync
  userId       String
  userBookId   String
  startedAt    DateTime // UTC
  endedAt      DateTime // UTC
  durationSec  Int
  unit         ProgressUnit
  progressFrom Int
  progressTo   Int
  createdAt    DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt]) // calendar queries
  @@index([userBookId])
}

// "Read 25 books in 2026". One per user per year: saving again updates it.
model ReadingGoal {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  // Number of books to finish that year
  target    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
}

// "Four favorites" on the profile. Rows have no built-in order, so the order
// is data: position 1–4. The whole list is replaced on every save.
model FavoriteBook {
  id         String @id @default(uuid())
  userId     String
  userBookId String @unique
  position   Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Removing the book from the shelf removes it from the favorites too
  userBook UserBook @relation(fields: [userBookId], references: [id], onDelete: Cascade)

  // No two books in one slot
  @@unique([userId, position])
}

// "follower follows following". Public: no requests to approve.
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  // The pair is the key: following someone twice is impossible
  @@id([followerId, followingId])
  // The key's index starts with followerId; "who follows X" needs this one
  @@index([followingId, createdAt])
}
