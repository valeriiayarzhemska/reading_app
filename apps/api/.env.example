# Copy this file to .env and adjust if needed. Never commit .env.
DATABASE_URL="postgresql://reading:reading@localhost:5433/reading?schema=public"
GOOGLE_BOOKS_API_KEY=""
# Signs access tokens. Generate: openssl rand -base64 48
JWT_SECRET=""
# 3000 is often taken by other local projects (e.g. Next.js)
PORT=3001
# Comma-separated audiences accepted for Google ID tokens (the web client ID)
GOOGLE_CLIENT_IDS=
