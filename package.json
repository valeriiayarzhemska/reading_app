{
  "name": "reading-app",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose stop",
    "db:migrate": "pnpm --filter @reading/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @reading/api exec prisma db seed",
    "db:studio": "pnpm --filter @reading/api exec prisma studio"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  }
}
